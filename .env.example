# ---------- Django ----------
SECRET_KEY=your_secret_key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Shaxsiy domenlar (masalan ngrok) shu yerga, kodga EMAS. Vergul bilan ajrating.
# CSRF_TRUSTED_ORIGINS=https://sizning-domeningiz.ngrok-free.dev,http://127.0.0.1:8000
# Bot yuboradigan kirish havolasi shu manzilga yaratiladi
SITE_URL=http://127.0.0.1:8000

# ---------- HTTPS / proksi ----------
# DEBUG=False bo'lganda sayt HTTPS talab qiladi. Docker'da http://localhost orqali
# sinab ko'rmoqchi bo'lsangiz False qiling. Productionda True qoldiring.
SECURE_SSL=False
# nginx/Render kabi ishonchli proksi ortida bo'lsangiz True, NUM_PROXIES esa proksilar soni
BEHIND_PROXY=False
NUM_PROXIES=0

# ---------- Telegram bot ----------
BOT_TOKEN=your_bot_token

# ---------- AI (Groq) ----------
GROQ_API_KEY=your_groq_api_key_here
# Bitta foydalanuvchi uchun kunlik AI so'rovlar limiti
AI_DAILY_LIMIT=30

# ---------- Kesh ----------
# docker-compose'da avtomatik beriladi. Productionda MAJBURIY: Redis'siz har bir
# Gunicorn worker alohida kesh yuritadi (limit va kvota noto'g'ri sanaladi).
# REDIS_URL=redis://127.0.0.1:6379/1

# ---------- Database ----------
# docker-compose bularni o'zi DATABASE_URL ga aylantiradi. Parolda @ : / belgilari bo'lmasin.
# Docker'siz ishlatsangiz DATABASE_URL ni to'g'ridan-to'g'ri bering:
# DATABASE_URL=postgres://user:pass@host:5432/dbname
DB_NAME=gym_db
DB_USER=gym_admin
DB_PASSWORD=your_real_db_password_here
DB_HOST=127.0.0.1
DB_PORT=5432
