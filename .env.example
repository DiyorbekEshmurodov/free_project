# Django sozlamalari
SECRET_KEY=your_secret_key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Sayt manzili (bot yuboradigan kirish havolasi shu manzilga yaratiladi)
SITE_URL=http://127.0.0.1:8000
# Render/nginx kabi ishonchli proksi ortida bo'lsangiz True qiling
BEHIND_PROXY=False

# Telegram Bot sozlamalari
BOT_TOKEN=your_bot_token

# AI API (Groq) sozlamalari
GROQ_API_KEY=your_groq_api_key_here
# Bitta foydalanuvchi uchun kunlik AI so'rovlar limiti
AI_DAILY_LIMIT=30

# Umumiy kesh (docker-compose da avtomatik beriladi). Productionda majburiy:
# bir nechta Gunicorn worker bo'lsa login urinishlari va AI kvota shunda to'g'ri sanaladi.
# REDIS_URL=redis://127.0.0.1:6379/1

# Database sozlamalari (DATABASE_URL berilsa shu ishlatiladi)
# DATABASE_URL=postgres://user:pass@host:5432/dbname
DB_NAME=gym_db
DB_USER=gym_admin
DB_PASSWORD=your_real_db_password_here
DB_HOST=127.0.0.1
DB_PORT=5432
